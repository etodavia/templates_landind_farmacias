<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %> | <%= settings.site_name || 'Sistema' %></title>
    <link rel="stylesheet" href="/css/admin.css">
    <link href="https://cdn.jsdelivr.net/npm/remixicon@3.5.0/fonts/remixicon.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700;900&display=swap" rel="stylesheet">
    <style>
        .midia-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
            gap: 2rem;
            margin-top: 2rem;
            padding: 1rem;
        }
        .midia-card {
            background: #ffffff;
            border-radius: 12px;
            overflow: hidden;
            border: 1px solid #e2e8f0;
            position: relative;
            transition: transform 0.3s, box-shadow 0.3s;
            box-shadow: 0 4px 6px rgba(0,0,0,0.05);
        }
        .midia-card.selected {
            border-color: var(--admin-accent);
            box-shadow: 0 0 0 3px rgba(214,40,40,0.12);
        }
        .midia-select {
            position: absolute;
            top: 12px;
            right: 12px;
            z-index: 3;
            width: 22px;
            height: 22px;
            accent-color: var(--admin-accent);
            cursor: pointer;
        }
        .midia-bulk-toolbar {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 16px;
            margin: 1rem;
            padding: 14px 16px;
            border: 1px solid #e2e8f0;
            border-radius: 12px;
            background: #f8fafc;
        }
        .midia-bulk-toolbar label { display: flex; align-items: center; gap: 9px; font-weight: 700; cursor: pointer; }
        .btn-delete-selected { border: 0; border-radius: 9px; padding: 11px 16px; background: #dc2626; color: #fff; font-weight: 800; cursor: pointer; }
        .btn-delete-selected:disabled { opacity: .45; cursor: not-allowed; }
        .midia-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 15px 30px rgba(0,0,0,0.1);
            border-color: var(--admin-accent);
        }
        .midia-img-wrapper {
            height: 180px;
            width: 100%;
            background: #f8fafc;
            display: flex;
            align-items: center;
            justify-content: center;
            overflow: hidden;
            border-bottom: 1px solid #e2e8f0;
            padding: 1rem;
        }
        .midia-img-wrapper img {
            max-width: 100%;
            max-height: 100%;
            object-fit: contain;
        }
        .midia-info {
            padding: 1.25rem;
        }
        .midia-name {
            font-size: 0.9rem;
            color: #1e293b;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
            margin-bottom: 0.5rem;
            font-weight: 700;
        }
        .midia-meta {
            font-size: 0.8rem;
            color: #64748b;
            margin-bottom: 1.25rem;
        }
        .midia-actions {
            display: flex;
            gap: 0.5rem;
        }
        .btn-copy {
            flex: 1;
            padding: 0.6rem;
            font-size: 0.8rem;
            background: #f1f5f9;
            color: #334155;
            border: 1px solid #cbd5e1;
            border-radius: 6px;
            cursor: pointer;
            transition: 0.2s;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 5px;
            font-weight: 600;
        }
        .btn-copy:hover {
            background: #e2e8f0;
            color: #0f172a;
        }
        .btn-delete-img {
            background: #fef2f2;
            color: #ef4444;
            border: 1px solid #fca5a5;
            padding: 0.6rem;
            border-radius: 6px;
            cursor: pointer;
            transition: 0.2s;
            display: flex;
            align-items: center;
            justify-content: center;
        }
        .btn-delete-img:hover {
            background: #ef4444;
            color: white;
            border-color: #ef4444;
        }
        .upload-area {
            background: #ffffff;
            border: 2px dashed #cbd5e1;
            border-radius: 12px;
            padding: 3rem 2rem;
            text-align: center;
            margin: 1rem;
            transition: 0.3s;
        }
        .upload-area:hover {
            border-color: var(--admin-accent);
            background: #f8fafc;
        }
    </style>
</head>
<body>
    <div class="admin-app">
        <%- include('../partials/admin-sidebar') %>
        
        <div class="admin-main">
            <header class="admin-header">
                <div class="header-left">
                    <button class="menu-toggle-btn" onclick="toggleAdminMenu()"><i class="ri-menu-line"></i></button>
                    <h1>Banco de Imagens (Galeria)</h1>
                </div>
            </header>

            <div class="admin-content-scroll">
                <div class="admin-card">
                    <div class="card-header" style="flex-direction: column; align-items: flex-start; gap: 1rem; margin: 1rem;">
                        <h2 class="card-title">Upload de Nova Imagem</h2>
                        <p style="color: #64748b; font-size: 0.95rem;">
                            As imagens enviadas por aqui podem ser utilizadas em Banners, Produtos ou Conteúdos colando a sua URL nos formulários.
                        </p>
                    </div>
                    <form action="/admin/midia/upload" method="POST" enctype="multipart/form-data" class="upload-area">
                        <i class="ri-upload-cloud-2-line" style="font-size: 3rem; color: var(--admin-accent); margin-bottom: 1rem; display: block;"></i>
                        <input type="file" name="imagem_file" id="imagem_file" required accept="image/*" style="display: block; margin: 0 auto 1rem;">
                        <button type="submit" class="btn btn-primary" style="padding: 0.5rem 1.5rem;">Fazer Upload</button>
                    </form>

                    <h2 class="card-title" style="margin: 3rem 1rem 1rem; padding-top: 2rem; border-top: 1px solid #e2e8f0; color: #1e293b;">Arquivos no Servidor</h2>
                    
                    <% if (files && files.length > 0) { %>
                        <form action="/admin/midia/delete-bulk" method="POST" id="bulkDeleteForm" onsubmit="return confirmBulkDelete();">
                            <div class="midia-bulk-toolbar">
                                <label><input type="checkbox" id="selectAllMedia"> Selecionar todas</label>
                                <button type="submit" class="btn-delete-selected" id="deleteSelectedBtn" disabled>
                                    <i class="ri-delete-bin-6-line"></i> Excluir selecionadas (<span id="selectedCount">0</span>)
                                </button>
                            </div>
                            <div class="midia-grid">
                            <% files.forEach(file => { %>
                                <div class="midia-card">
                                    <input type="checkbox" class="midia-select" name="filenames" value="<%= file.name %>" aria-label="Selecionar <%= file.name %>">
                                    <div class="midia-img-wrapper">
                                        <img src="<%= file.url %>" alt="<%= file.name %>" loading="lazy">
                                    </div>
                                    <div class="midia-info">
                                        <div class="midia-name" title="<%= file.name %>"><%= file.name %></div>
                                        <div class="midia-meta">
                                            <%= file.size %> • <%= new Date(file.mtime).toLocaleDateString('pt-BR') %>
                                        </div>
                                        <div class="midia-actions">
                                            <button type="button" class="btn-copy" onclick="copyUrl(this, '<%= file.url %>')">
                                                <i class="ri-file-copy-line"></i> Copiar URL
                                            </button>
                                            <button type="button" class="btn-delete-img" title="Excluir Imagem" data-filename="<%= file.name %>" onclick="deleteSingleMedia(this.dataset.filename);">
                                                <i class="ri-delete-bin-line"></i>
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            <% }) %>
                            </div>
                        </form>
                    <% } else { %>
                        <div class="empty-state" style="padding: 3rem 0; text-align: center; color: rgba(255,255,255,0.4);">
                            <i class="ri-image-2-line" style="font-size: 3rem; margin-bottom: 1rem; display: block;"></i>
                            <p>Nenhuma imagem no servidor ainda.</p>
                        </div>
                    <% } %>
                </div>
            </div>
        </div>
    </div>

    <script>
        function copyUrl(btn, url) {
            navigator.clipboard.writeText(url).then(() => {
                const originalText = btn.innerHTML;
                btn.innerHTML = '<i class="ri-check-line"></i> Copiado!';
                btn.style.background = 'rgba(46, 204, 113, 0.2)';
                btn.style.color = '#2ecc71';
                setTimeout(() => {
                    btn.innerHTML = originalText;
                    btn.style.background = '';
                    btn.style.color = '';
                }, 2000);
            });
        }

        function deleteSingleMedia(filename) {
            if (!confirm('Tem certeza que deseja excluir esta imagem? Se ela estiver sendo usada no site, ela sumirá da tela.')) return;
            const form = document.createElement('form');
            form.method = 'POST';
            form.action = '/admin/midia/delete';
            const input = document.createElement('input');
            input.type = 'hidden';
            input.name = 'filename';
            input.value = filename;
            form.appendChild(input);
            document.body.appendChild(form);
            form.submit();
        }

        const mediaCheckboxes = Array.from(document.querySelectorAll('.midia-select'));
        const selectAllMedia = document.getElementById('selectAllMedia');
        const deleteSelectedBtn = document.getElementById('deleteSelectedBtn');
        const selectedCount = document.getElementById('selectedCount');

        function updateMediaSelection() {
            const selected = mediaCheckboxes.filter(item => item.checked);
            mediaCheckboxes.forEach(item => item.closest('.midia-card')?.classList.toggle('selected', item.checked));
            selectedCount.textContent = selected.length;
            deleteSelectedBtn.disabled = selected.length === 0;
            selectAllMedia.checked = selected.length === mediaCheckboxes.length && mediaCheckboxes.length > 0;
            selectAllMedia.indeterminate = selected.length > 0 && selected.length < mediaCheckboxes.length;
        }

        selectAllMedia?.addEventListener('change', () => {
            mediaCheckboxes.forEach(item => { item.checked = selectAllMedia.checked; });
            updateMediaSelection();
        });
        mediaCheckboxes.forEach(item => item.addEventListener('change', updateMediaSelection));

        function confirmBulkDelete() {
            const total = mediaCheckboxes.filter(item => item.checked).length;
            return total > 0 && confirm(`Excluir permanentemente ${total} ${total === 1 ? 'imagem selecionada' : 'imagens selecionadas'}? Imagens em uso desaparecerão do site.`);
        }
    </script>
</body>
</html>
